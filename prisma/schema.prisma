generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// Auth tables (required by NextAuth Prisma adapter)
// ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // null for OAuth-only users

  // PandaLearn gamification
  xp           Int      @default(0)
  level        Int      @default(1)
  streak       Int      @default(0)
  gems         Int      @default(0)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  track        String?  // "school" | "engineering"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  moduleProgress ModuleProgress[]
  achievements   UserAchievement[]
  quizAttempts   QuizAttempt[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ──────────────────────────────────────────
// Learning data
// ──────────────────────────────────────────

model ModuleProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  moduleId    String    @map("module_id")   // e.g. "dsa-arrays"
  subject     String                         // e.g. "DSA"
  track       String                         // "school" | "engineering"
  completed   Boolean   @default(false)
  xpEarned    Int       @default(0) @map("xp_earned")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("module_progress")
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  iconName    String @map("icon_name") // lucide icon name
  xpReward    Int    @default(0) @map("xp_reward")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model QuizAttempt {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  moduleId String   @map("module_id")
  score    Int      // 0–100
  passed   Boolean
  takenAt  DateTime @default(now()) @map("taken_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // "module_complete" | "quiz_pass" | "achievement" | "level_up" | "streak"
  title       String
  description String?
  xpGained    Int      @default(0) @map("xp_gained")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
